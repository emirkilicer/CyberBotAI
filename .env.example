# ---------------------------------------------------------------------------
# Local example. DEBUG is off by default; static files are served by WhiteNoise
# from STATIC_ROOT, so run `python manage.py collectstatic` after changes.
# Set DJANGO_DEBUG=True only while actively developing.
# Do NOT use these values in production.
# Generate real secrets with the commands below, then set production flags.
#
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ---------------------------------------------------------------------------

DJANGO_DEBUG=False

# Required for local HTTP development. Remove or set to False in production.
DJANGO_ALLOW_INSECURE_HTTP=True

# Required. Minimum 32 characters; values starting with "change-me" are refused.
DJANGO_SECRET_KEY=change-me-generate-a-real-secret-key

# Comma separated. Include the public hostname(s) in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SITE_URL=http://localhost:8081

# Required in production (PostgreSQL). Leave empty for local SQLite.
DATABASE_URL=

# Required when DEBUG=False. Supports comma separated keys for rotation.
TOTP_ENCRYPTION_KEY=change-me-generate-a-fernet-key
TOTP_ISSUER=CYBERBOT

# Production transport security (leave off for local HTTP).
DJANGO_SECURE_COOKIES=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_TRUST_PROXY=False

# Shared cache for rate limiting. Required with more than one worker/replica.
REDIS_URL=

# Limits (optional overrides).
LOGIN_ATTEMPT_LIMIT=10
LOGIN_ATTEMPT_WINDOW_SECONDS=900
TWO_FACTOR_MAX_ATTEMPTS=5
TWO_FACTOR_LOCKOUT_SECONDS=900
SIGNUP_RATE_LIMIT_PER_HOUR=10
CHAT_RATE_LIMIT_PER_MINUTE=20

# Admin protection (empty allowlist = allow all, local only).
ADMIN_LOGIN_ATTEMPT_LIMIT=5
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_IP_ALLOWLIST=

# Account recovery / email. Local console backend; production SMTP.
DJANGO_REQUIRE_EMAIL_VERIFICATION=False
DJANGO_PASSWORD_RESET_TIMEOUT=3600
DJANGO_DEFAULT_FROM_EMAIL=noreply@cyberbot.local
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False

# Structured JSON logs for SIEM ingestion (set True in production).
DJANGO_LOG_JSON=False

# AI (optional: authentication works without a key, chat returns 503).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=2048
CHAT_MAX_MESSAGE_LENGTH=2000
